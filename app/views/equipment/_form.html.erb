<%= form_with(model: equipment) do |form| %>
  <% if equipment.errors.any? %>
    <div class="br-message danger mb-3" role="alert">
      <div class="icon"><i class="fas fa-times-circle" aria-hidden="true"></i></div>
      <div class="content">
        <span class="message-title">Erro:</span>
        <span class="message-body"><%= pluralize(equipment.errors.count, "erro") %> impediram o salvamento:</span>
        <ul>
          <% equipment.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="row">
    <div class="col-sm-12 mb-3">
      <div class="br-select fluid">
        <div class="br-input">
          <label for="select-kind">Tipo de Equipamento</label>
          <input id="select-kind" type="text" placeholder="Selecione o tipo..." readonly="readonly" />
          <button class="br-button" type="button" aria-label="Exibir lista" tabindex="-1" data-trigger="data-trigger"><i class="fas fa-angle-down" aria-hidden="true"></i>
          </button>
        </div>
        <div class="br-list" tabindex="0">
          <div class="br-item" tabindex="-1">
            <div class="br-radio">
              <%= form.radio_button :kind, 'notebook', id: 'kind_notebook' %>
              <label for="kind_notebook">Notebook</label>
            </div>
          </div>
          <div class="br-item" tabindex="-1">
            <div class="br-radio">
              <%= form.radio_button :kind, 'printer', id: 'kind_printer' %>
              <label for="kind_printer">Impressora</label>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-sm-6 mb-3">
      <div class="br-input">
        <%= form.label :brand, "Marca" %>
        <%= form.text_field :brand, placeholder: "Ex: Dell, HP" %>
      </div>
    </div>
    <div class="col-sm-6 mb-3">
      <div class="br-input">
        <%= form.label :model, "Modelo" %>
        <%= form.text_field :model, placeholder: "Ex: Daten - Dvin 4 " %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-sm-6 mb-3">
      <div class="br-input">
        <%= form.label :serial_number, "Tombamento" %>
        <%= form.text_field :serial_number, placeholder: "Ex: Sudene-7450364" %>
      </div>
    </div>
    <div class="col-sm-6 mb-3">
      <div class="br-input">
        <%= form.label :responsible, "Responsável" %>
        <%= form.text_field :responsible, placeholder: "Ex: Pedro" %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-sm-6 mb-3">
      <div class="br-input">
        <!-- [html-validate-disable input-attributes]-->
        <div class="br-datetimepicker" data-mode="single" data-type="text">
          <div class="br-input has-icon">
            <%= form.label :acquisition_date, "Data de Aquisição" %>
            <%= form.text_field :acquisition_date, id: "range-input", placeholder: "Selecione uma data", data: { input: "data-input" } %>
            <button class="br-button circle small" type="button" aria-label="Abrir Timepicker" data-toggle="data-toggle" id="range-input-btn" tabindex="-1" aria-hidden="true"><i class="fas fa-calendar-alt" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 mb-3">
      <div class="br-select fluid">
        <div class="br-input">
          <label for="select-status">Status</label>
          <input id="select-status" type="text" placeholder="Selecione o status..." readonly="readonly" />
          <button class="br-button" type="button" aria-label="Exibir lista" tabindex="-1" data-trigger="data-trigger"><i class="fas fa-angle-down" aria-hidden="true"></i>
          </button>
        </div>
        <div class="br-list" tabindex="0">
          <div class="br-item" tabindex="-1">
            <div class="br-radio">
              <%= form.radio_button :status, 'Disponível', id: 'status_available' %>
              <label for="status_available">Disponível</label>
            </div>
          </div>
          <div class="br-item" tabindex="-1">
            <div class="br-radio">
              <%= form.radio_button :status, 'Em uso', id: 'status_in_use' %>
              <label for="status_in_use">Em uso</label>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-sm-12 mb-3">
      <div class="br-upload">
        <label class="upload-label" for="document-upload"><span>Termo/Relatório</span></label>
        <%= form.file_field :document, class: "upload-input", id: "document-upload" %>
        <div class="upload-list"></div>
      </div>
      <p class="text-base mt-1">Envie o termo de responsabilidade ou relatório técnico.</p>
    </div>
  </div>

  <div class="d-flex justify-content-end mt-3">
    <%= link_to "Cancelar", equipment_index_path, class: "br-button secondary mr-2" %>
    <%= form.submit "Salvar Equipamento", class: "br-button primary" %>
  </div>
<% end %>
