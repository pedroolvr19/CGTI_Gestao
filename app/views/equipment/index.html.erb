<% content_for :title, "Equipamentos" %>

  <% if notice.present? %>
    <div class="br-message success mb-3" role="alert">
      <div class="icon"><i class="fas fa-check-circle" aria-hidden="true"></i></div>
      <div class="content"><span class="message-title">Sucesso:</span><span class="message-body"><%= notice %></span></div>
      <div class="close">
        <button class="br-button circle small" type="button" aria-label="Fechar"><i class="fas fa-times" aria-hidden="true"></i></button>
      </div>
    </div>
  <% end %>

  <div class="row justify-content-center">
    <div class="col-12">
      <div class="d-flex justify-content-end align-items-center mb-3">
        <%= link_to new_equipment_path, class: "br-button primary" do %>
          <i class="fas fa-plus mr-1" aria-hidden="true"></i>
          Novo Equipamento
        <% end %>
      </div>

      <div class="br-table" data-search="data-search" data-selection="data-selection" data-collapse="data-collapse" data-random="data-random">
        <div class="table-header">
          <div class="top-bar">
            <div class="table-title">Equipamentos</div>
            <div class="actions-trigger text-nowrap">
              <button class="br-button circle" type="button" id="button-dropdown-density" title="Ver mais opções" data-toggle="dropdown" data-target="target01-52512" aria-label="Definir densidade da tabela" aria-haspopup="true" aria-live="polite"><i class="fas fa-ellipsis-v" aria-hidden="true"></i>
              </button>
              <div class="br-list" id="target01-52512" role="menu" aria-labelledby="button-dropdown-density" hidden="hidden">
                <%= link_to equipment_index_path, class: "br-item", role: "menuitem" do %>
                  Limpar Filtro
                <% end %>
              </div>
            </div>
            <div class="search-trigger">
              <button class="br-button circle" type="button" id="button-input-search" data-toggle="search" aria-label="Abrir busca" aria-controls="table-searchbox-52512"><i class="fas fa-search" aria-hidden="true"></i>
              </button>
            </div>
          </div>
          <div class="search-bar">
            <%= form_with url: equipment_index_path, method: :get, local: true, class: "br-input" do |form| %>
              <label for="table-searchbox-52512">Buscar na tabela</label>
              <%= form.text_field :query, id: "table-searchbox-52512", type: "search", placeholder: "Buscar na tabela", aria: { labelledby: "button-input-search", label: "Buscar na tabela" }, value: params[:query] %>
              <button class="br-button" type="submit" aria-label="Buscar"><i class="fas fa-search" aria-hidden="true"></i>
              </button>
            <% end %>
            <button class="br-button circle" type="button" data-dismiss="search" aria-label="Fechar busca"><i class="fas fa-times" aria-hidden="true"></i>
            </button>
          </div>
          <div class="selected-bar">
            <div class="info"><span class="count">0</span><span class="text">item selecionado</span></div>
            <div class="actions-trigger text-nowrap">
              <button class="br-button circle inverted" type="button" id="button-dropdown-selection" data-toggle="dropdown" data-target="target02-52512" aria-controls="target02-52512" aria-label="Ver mais opções de ação" aria-haspopup="true"><i class="fas fa-ellipsis-v" aria-hidden="true"></i>
              </button>
              <div class="br-list" id="target02-52512" role="menu" aria-labelledby="button-dropdown-selection" hidden="hidden">
                <button class="br-item" type="button" data-toggle="" role="menuitem">Ação 1
                </button><span class="br-divider"></span>
                <button class="br-item" type="button" role="menuitem">Ação 2
                </button>
              </div>
            </div>
          </div>
        </div>
        <table>
          <caption>Lista de Equipamentos</caption>
          <thead>
            <tr>
              <td class="column-collapse" scope="col" aria-hidden="true"></td>
              <th class="column-checkbox" scope="col">
                <div class="br-checkbox hidden-label">
                  <input id="check-all-52512" name="check-all-52512" type="checkbox" aria-label="Selecionar tudo" data-parent="check-01-52512"/>
                  <label for="check-all-52512">Selecionar todas as linhas</label>
                </div>
              </th>
              <th scope="col">Tipo</th>
              <th scope="col">Marca/Modelo</th>
              <th scope="col">Tombamento</th>
              <th scope="col">Responsável</th>
              <th scope="col">Aquisição</th>
              <th scope="col">Status</th>
              <th scope="col">Termo/Relatório</th>
              <th scope="col">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if @equipment.any? %>
              <% @equipment.each_with_index do |equipment, index| %>
                <tr>
                  <td>
                    <button class="br-button circle small" type="button" id="button-line-<%= index %>-52512" aria-label="Expandir/Retrair Rótulo 01" data-toggle="collapse" data-target="collapse-<%= index %>-4-52512" aria-describedby="collapse-<%= index %>-4-52512"><i class="fas fa-chevron-down" aria-hidden="true"></i>
                    </button>
                  </td>
                  <td>
                    <div class="br-checkbox hidden-label">
                      <input id="check-line-<%= index %>-52512" name="check-line-<%= index %>-52512" type="checkbox" aria-label="Selecionar linha <%= index %>" data-child="check-01-52512"/>
                      <label for="check-line-<%= index %>-52512">Selecionar linha <%= index %></label>
                    </div>
                  </td>
                  <td data-th="Tipo">
                    <span class="br-tag equipment-tag <%= equipment.notebook? ? 'interaction' : 'highlight' %>">
                      <%= equipment.kind == 'printer' ? 'Impressora' : equipment.kind.capitalize %>
                    </span>
                  </td>
                  <td data-th="Marca/Modelo">
                    <div class="text-bold"><%= equipment.brand %></div>
                    <div><%= equipment.model %></div>
                  </td>
                  <td data-th="Tombamento"><%= equipment.serial_number %></td>
                  <td data-th="Responsável"><%= equipment.responsible %></td>
                  <td data-th="Aquisição"><%= equipment.acquisition_date&.strftime("%d/%m/%Y") %></td>
                  <td data-th="Status"><%= equipment.status %></td>
                  <td data-th="Termo/Relatório">
                    <% if equipment.document.attached? %>
                      <%= link_to rails_blob_path(equipment.document, disposition: "attachment"), class: "br-button circle small secondary", title: "Baixar Termo/Relatório" do %>
                        <i class="fas fa-file-download" aria-hidden="true"></i>
                      <% end %>
                    <% else %>
                      <button class="br-button circle small secondary" disabled title="Sem documento">
                        <i class="fas fa-file" aria-hidden="true"></i>
                      </button>
                    <% end %>
                  </td>
                  <td data-th="Ações">
                    <div class="d-flex">
                      <%= link_to equipment, class: "br-button circle small secondary mr-1", title: "Ver" do %>
                        <i class="fas fa-eye" aria-hidden="true"></i>
                      <% end %>
                      <%= link_to edit_equipment_path(equipment), class: "br-button circle small secondary mr-1", title: "Editar" do %>
                        <i class="fas fa-edit" aria-hidden="true"></i>
                      <% end %>

                    </div>
                  </td>
                </tr>
                <tr class="collapse">
                  <td id="collapse-<%= index %>-4-52512" aria-hidden="true" hidden="hidden" colspan="10">
                    Detalhes adicionais do equipamento <%= equipment.brand %> <%= equipment.model %> (Série: <%= equipment.serial_number %>).
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="10" class="text-center">Nenhum equipamento cadastrado.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <div class="table-footer">
          <div class="d-flex justify-content-center">
        <%== pagy_bootstrap_nav(@pagy) %>
      </div>
        </div>
      </div>
    </div>
  </div>
