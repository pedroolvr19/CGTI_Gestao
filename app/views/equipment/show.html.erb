<% content_for :title, "#{@equipment.brand} #{@equipment.model}" %>

  <% if notice.present? %>
    <div class="br-message success mb-3" role="alert">
      <div class="icon"><i class="fas fa-check-circle" aria-hidden="true"></i></div>
      <div class="content"><span class="message-title">Sucesso:</span><span class="message-body"><%= notice %></span></div>
      <div class="close">
        <button class="br-button circle small" type="button" aria-label="Fechar"><i class="fas fa-times" aria-hidden="true"></i></button>
      </div>
    </div>
  <% end %>

  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="br-card mt-5">
        <div class="card-header">
          <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
              <span class="br-avatar mr-3" title="<%= @equipment.brand %>">
                <span class="content"><%= @equipment.brand[0].upcase %></span>
              </span>
              <div class="ml-3">
                <div class="text-weight-semi-bold text-up-02"><%= @equipment.brand %> <%= @equipment.model %></div>
                <div><%= @equipment.kind == 'printer' ? 'Impressora' : @equipment.kind.capitalize %></div>
              </div>
            </div>
            <div class="ml-auto">
              <span class="br-tag <%= @equipment.status == 'Em uso' ? 'success' : 'info' %>"><%= @equipment.status %></span>
            </div>
          </div>
        </div>
        <div class="card-content">
          <div class="row">
            <div class="col-sm-6 mb-3">
              <div class="text-weight-semi-bold">Número de Série</div>
              <div><%= @equipment.serial_number %></div>
            </div>
            <div class="col-sm-6 mb-3">
              <div class="text-weight-semi-bold">Responsável</div>
              <div><%= @equipment.responsible.presence || "-" %></div>
            </div>
            <div class="col-sm-6 mb-3">
              <div class="text-weight-semi-bold">Data de Aquisição</div>
              <div><%= @equipment.acquisition_date&.strftime("%d/%m/%Y") %></div>
            </div>
            <div class="col-sm-6 mb-3">
              <div class="text-weight-semi-bold">Termo/Relatório</div>
              <div>
                <% if @equipment.document.attached? %>
                  <%= link_to rails_blob_path(@equipment.document, disposition: "attachment"), class: "br-button secondary small mt-1", title: "Baixar Termo/Relatório" do %>
                    <i class="fas fa-file-download mr-1" aria-hidden="true"></i> Baixar
                  <% end %>
                <% else %>
                  <span>-</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
        <div class="card-footer">
          <div class="d-flex justify-content-end">
            <%= link_to "Voltar", equipment_index_path, class: "br-button secondary mr-2" %>
            <%= link_to "Editar", edit_equipment_path(@equipment), class: "br-button primary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
