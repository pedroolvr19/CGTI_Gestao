<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta http-equiv="X-UA-Compatible" content="ie=edge"/>
    <title><%= content_for(:title) || "Gestão de Equipamentos" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <!-- Fontes -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Raleway:300,400,500,600,700,800,900&amp;display=swap"/>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"/>
    <!-- Gov.br Design System -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@govbr-ds/core@3.0.0/dist/core.min.css"/>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div class="template-base">
      <%= render "shared/header" %>

      <main class="d-flex flex-fill mb-5" id="main">
        <div class="container-lg">
          <div class="row">
            <div class="br-menu" id="main-navigation">
              <div class="menu-container">
                <div class="menu-panel">
                  <div class="menu-header">
                    <div class="menu-title">
                        <%= image_tag "logo-gov.png", alt: "logo" %>
                      <span>Gestão de Equipamentos</span>
                    </div>
                    <div class="menu-close">
                      <button class="br-button circle" type="button" aria-label="Fechar o menu" data-dismiss="menu">
                        <i class="fas fa-times" aria-hidden="true"></i>
                      </button>
                    </div>
                  </div>
                  <nav class="menu-body" role="tree">

                    <a class="menu-item" href="<%= equipment_index_path %>" role="treeitem">
                      <span class="icon"><i class="fas fa-laptop" aria-hidden="true"></i></span>
                      <span class="content">Equipamentos</span>
                    </a>
                    <a class="menu-item" href="<%= new_equipment_path %>" role="treeitem">
                      <span class="icon"><i class="fas fa-plus-circle" aria-hidden="true"></i></span>
                      <span class="content">Novo Equipamento</span>
                    </a>
                  </nav>
                  <div class="menu-footer">
                    <div class="menu-info">
                    </div>
                  </div>
                </div>
                <div class="menu-scrim" data-dismiss="menu" tabindex="0"></div>
              </div>
            </div>
            <div class="col mb-5">
              <div class="main-content pl-sm-3 mt-4" id="main-content">

                <%= yield %>
              </div>
            </div>
          </div>
        </div>
      </main>

      <%= render "shared/footer" %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/@govbr-ds/core@3.0.0/dist/core-init.min.js"></script>
  </body>
</html>
