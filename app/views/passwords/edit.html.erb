<div class="row justify-content-center mt-5">
  <div class="col-sm-8 col-md-6 col-lg-4">
    <div class="br-card">
      <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
          <div class="d-flex">
            <div class="header-title">Redefinir Senha</div>
          </div>
        </div>
      </div>
      <div class="card-content">
        <% if alert = flash[:alert] %>
          <div class="br-message danger mb-3" role="alert">
            <div class="icon"><i class="fas fa-times-circle" aria-hidden="true"></i></div>
            <div class="content"><%= alert %></div>
          </div>
        <% end %>

        <%= form_with url: password_path(params[:token]), method: :put do |form| %>
          <div class="br-input mb-3">
            <%= form.label :password, "Nova senha" %>
            <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Digite a nova senha", maxlength: 72 %>
          </div>

          <div class="br-input mb-3">
            <%= form.label :password_confirmation, "Confirmar nova senha" %>
            <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repita a nova senha", maxlength: 72 %>
          </div>

          <div class="d-flex justify-content-end">
            <%= form.submit "Salvar nova senha", class: "br-button primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
