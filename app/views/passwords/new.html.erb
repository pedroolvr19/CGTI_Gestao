<div class="row justify-content-center mt-5">
  <div class="col-sm-8 col-md-6 col-lg-4">
    <div class="br-card">
      <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
          <div class="d-flex">
            <div class="header-title">Recuperar Senha</div>
          </div>
        </div>
      </div>
      <div class="card-content">
        <% if alert = flash[:alert] %>
          <div class="br-message danger mb-3" role="alert">
            <div class="icon"><i class="fas fa-times-circle" aria-hidden="true"></i></div>
            <div class="content"><%= alert %></div>
          </div>
        <% end %>

        <%= form_with url: passwords_path do |form| %>
          <div class="br-input mb-3">
            <%= form.label :email_address, "Endereço de e-mail" %>
            <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "Ex: joao@exemplo.com" %>
          </div>

          <div class="d-flex justify-content-end">
            <%= form.submit "Enviar", class: "br-button primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
